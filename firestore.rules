rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════
    // PRODUCTION-SAFE RULES
    // All privileged writes go through Next.js API routes using
    // Firebase Admin SDK, which bypasses these rules entirely.
    // These rules only govern direct client SDK access.
    // ═══════════════════════════════════════════════════════════════════

    // ── PUBLIC CATALOG (Read-only for clients) ───────────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if false;  // Admin SDK only (via /api/admin/firestore)
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if false;
    }

    match /hero_banner/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /header_footer/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if false;
    }

    // ── SETTINGS (Selective public read, no client write) ────────────
    match /settings/{settingId} {
      allow read: if settingId in ['shipping', 'header_footer', 'contact', 'tracking', 'hero', 'favicon'];
      allow write: if false;
    }

    // ── ORDERS (Admin SDK only) ─────────────────────────────────────
    match /orders/{orderId} {
      allow read, write: if false;
    }

    // ── CUSTOMERS (Admin SDK only via /api/public/customers) ────────
    match /customers/{customerId} {
      allow read, write: if false;
    }

    // ── FRAUD AUDIT LOGS (Admin SDK only) ───────────────────────────
    match /fraud_audit_log/{logId} {
      allow read, write: if false;
    }

    // ── CHAT SYSTEM (Client SDK — no Firebase Auth in this project) ─
    match /conversations/{conversationId} {
      // Anyone can create a conversation (customers start chats)
      allow create: if request.resource.data.keys().hasAll(['customerName', 'status', 'createdAt'])
                    && request.resource.data.status == 'open';

      // Read: Allow (no Firebase Auth to verify identity)
      allow read: if true;

      // Update: Allow (status changes, unread count resets)
      allow update: if true;

      // Delete: Allow (admins can delete conversations)
      allow delete: if true;

      // Messages subcollection
      match /messages/{messageId} {
        // Anyone can read messages in accessible conversations
        allow read: if true;

        // Anyone can create a message (customer or admin)
        allow create: if request.resource.data.keys().hasAll(['message', 'senderType', 'createdAt'])
                      && request.resource.data.message is string
                      && request.resource.data.message.size() <= 2000
                      && request.resource.data.senderType in ['customer', 'admin'];

        // Allow updating isRead field
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);

        // Allow deleting messages
        allow delete: if true;
      }
    }
  }
}
